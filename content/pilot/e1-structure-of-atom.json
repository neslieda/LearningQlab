    ],
    "language": "en",
    "calculator": true,
    "difficulty": "medium",
    "primary_syllabus_node": "E.1",
    "secondary_syllabus_nodes": [],
    "outcome": "Formation of an absorption spectrum; composition from a spectrum",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "White light from a hot filament passes through cool, low-pressure sodium vapour. The transmitted light is then dispersed by a diffraction grating and viewed on a screen."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is observed on the screen?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "statement",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "A continuous spectrum crossed by dark lines at certain wavelengths that sodium can emit"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "Bright lines on a dark background at certain wavelengths that sodium can emit"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Confuses an absorption spectrum with an emission spectrum; this picture is the spectrum given by hot vapour on its own"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "A continuous spectrum with no lines"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Thinks a low-pressure gas is completely transparent to light and does not interact with photons"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "A continuous spectrum with brighter lines at certain wavelengths that sodium can emit"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Thinks the vapour \"adds\" its own lines to the transmitted light; misses that re-emission is in all directions"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "A",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "The atoms in the vapour absorb only photons whose energy equals the differences between energy levels; these are among the wavelengths the atom can emit (in a cool vapour only transitions starting from the ground level). Because the absorbed energy is re-emitted in all directions, the intensity at these wavelengths is reduced in the direction of observation: dark lines on a continuous spectrum (an absorption spectrum)."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
  },
  {
