    "outcome": "Qualitative effect of damping on the maximum amplitude and the resonant frequency",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A lightly damped system is driven by a periodic force. The frequency of the driving force is varied and the amplitude of the system is measured. The damping of the system is then increased, but the damping remains light."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the effect of the increased damping on the maximum amplitude and on the frequency at which the maximum amplitude occurs?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "statement",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The maximum amplitude decreases and it occurs at a slightly lower frequency."
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The maximum amplitude decreases and it occurs at a slightly higher frequency."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Gets the amplitude effect right but takes the frequency shift to be in the opposite direction (\"damping stiffens the system\")"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The maximum amplitude increases and it occurs at a slightly lower frequency."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Gets the frequency effect right; assumes damping \"sharpens and raises\" the resonance peak"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The maximum amplitude increases and it occurs at a slightly higher frequency."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes both effects to be the other way round"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "A",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "As damping increases, the system loses more energy in each oscillation; the maximum amplitude at resonance decreases and the resonance curve broadens. The frequency at which the maximum amplitude occurs shifts slightly below the natural frequency."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
