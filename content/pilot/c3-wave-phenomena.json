        }
       ],
       "rationale": null
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "5"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Rounds 4.17 up; for n = 5, sin θ = 1.2 > 1, so this order does not occur"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "8"
