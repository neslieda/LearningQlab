     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A rectangular coil has 20 turns and sides of length 0.10 m and 0.20 m. The coil moves at a constant speed of 0.50 m s⁻¹ into a region of uniform magnetic field of strength 0.30 T. The plane of the coil is at right angles to the field. The leading side of the coil has length 0.10 m and is at right angles to the velocity. The coil is partly inside the field."
        }
       ]
      },
      {
       "type": "figure",
       "attrs": {
        "stimulus_id": "fig1"
       }
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the emf induced in the coil?"
        }
       ]
      }
     ]
    },
    "stimuli": [
     {
      "id": "fig1",
      "kind": "schematic_diagram",
      "use": "read_only",
      "description": "A rectangular coil in the plane of the page (short side 0.10 m vertical, long side 0.20 m horizontal) moving to the right with velocity v. On the right, a region of uniform magnetic field perpendicular to the page (⊗ symbols) begins at a vertical boundary line. The 0.10 m side of the coil on the right is inside the field and the side on the left is outside it. Diagram not to scale.",
      "asset_id": null,
      "alt_text": null
     }
    ],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
