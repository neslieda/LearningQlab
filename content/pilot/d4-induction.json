          ]
         }
        ]
       }
      }
     ],
     "correct_key": "C",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "Only the leading side, which is inside the field, cuts the flux lines. For each turn ε = BvL = 0.30 × 0.50 × 0.10 = 0.015 V; the 20 turns are in series, so ε = 20 × 0.015 = 0.30 V. (Equivalent: the rate of change of flux linkage is N B L v.)"
         }
        ]
       }
      ]
