     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Monochromatic light of wavelength 600 nm is incident normally on a single rectangular slit of width 0.10 mm. A diffraction pattern is observed on a screen that is 2.0 m from the slit."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the width of the central maximum on the screen?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
