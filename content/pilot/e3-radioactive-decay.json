         "type": "paragraph",
         "content": [
          {
           "marks": [],
           "type": "text",
           "text": "Show that the decay constant of iodine-131 is about 1.0 × 10⁻⁶ s⁻¹."
          }
         ]
        }
       ]
      },
      "marks": 2,
      "marks_capped": false,
      "show_that": true,
