    "outcome": "Direction of motion of a medium particle in a transverse wave (displacement against position)",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A transverse wave travels to the right along a horizontal rope. At one instant, a point P on the rope is at its equilibrium position. At this instant the crest nearest to P is 0.10 m to the left of P and the trough nearest to P is 0.10 m to the right of P. At a crest the rope is displaced upwards."
        }
       ]
      },
      {
       "type": "figure",
       "attrs": {
        "stimulus_id": "fig1"
       }
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the direction of motion of P at this instant?"
        }
       ]
      }
     ]
    },
    "stimuli": [
     {
      "id": "fig1",
      "kind": "schematic_diagram",
      "use": "read_only",
      "description": "A snapshot of a sinusoidal wave travelling to the right along a horizontal rope. Point P is on the equilibrium line; to its left, 0.10 m away, is a crest and to its right, 0.10 m away, is a trough. The direction of travel of the wave is shown by an arrow pointing right. The question can be solved from the information in the text without the figure.",
      "asset_id": null,
      "alt_text": null
     }
    ],
    "mcq": {
     "option_kind": "word_phrase",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "to the left"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Assumes the particle is pulled towards the approaching crest (the direction the wave comes from)"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "to the right"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Assumes the medium particles travel along with the wave"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "downwards"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Reads the snapshot like a \"slope\": because the rope descends from the crest to the trough, P is assumed to move down too (this would be correct if the wave travelled to the left)"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "upwards"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      }
     ],
     "correct_key": "D",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "The wave travels to the right; the crest to the left of P reaches P shortly afterwards. So P is moving upwards. In a transverse wave a particle moves only perpendicular to the direction of travel."
         }
        ]
       }
      ]
     },
     "assessment_objective": 3,
     "level_content": "sl_core",
