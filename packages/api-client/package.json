{
  "name": "@qlab/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed API client generated from apps/api/openapi.json. Generated types are never edited by hand.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "engines": { "node": ">=24" },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
