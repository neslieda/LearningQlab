          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "İki çekirdeğin hacmi eşit sayılır; yalnızca kütle oranı alınır: 216 / 27 = 8"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
