    "outcome": "Iraklık açısıyla uzaklık; parsek–ışık yılı dönüşümü",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "The parallax angle of a star measured from Earth is 0.040 arc-seconds. 1 pc = 3.26 ly."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the distance from Earth to the star?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0.13 ly"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Uzaklık ıraklık açısıyla doğru orantılı alınır: 0.040 × 3.26 = 0.13"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "7.7 ly"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Dönüşüm ters yapılır: 25 / 3.26 = 7.7"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "25 ly"
            }
           ]
