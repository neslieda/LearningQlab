             "marks": [],
             "type": "text",
             "text": "2.5"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Çıkan nötronların hepsinin yeni fisyon başlattığı düşünülür; bu durumda tepkime hızı üstel artar"
           }
          ]
         }
        ]
