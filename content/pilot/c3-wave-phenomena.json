        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Bir sonraki minimum alınır (yol farkı = 3λ/2); bu frekansta da minimum vardır ama en düşük değildir: 3 × 340 / (2 × 0.68) = 750 Hz"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "Yol farkı = 2.68 − 2.00 = 0.68 m. Yıkıcı girişim için yol farkı = (n + ½)λ; en düşük frekans en büyük dalga boyuna karşılık gelir: λ/2 = 0.68 m → λ = 1.36 m → f = 340 / 1.36 = 250 Hz."
         }
        ]
       }
      ]
     },
