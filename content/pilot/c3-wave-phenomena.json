  {
   "source_ref": "pilot/c3-wave-phenomena#2",
   "number": 2,
   "document": {
    "schema_version": "1.0",
    "question_class": "mcq",
    "exam_section": "paper_1a",
    "levels": [
     "sl",
     "hl"
    ],
    "language": "en",
    "calculator": true,
    "difficulty": "easy",
    "primary_syllabus_node": "C.3",
    "secondary_syllabus_nodes": [],
    "outcome": "Double slit; proportionality with s = λD/d",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Monochromatic light is incident normally on two narrow parallel slits. Fringes are observed on a distant screen. The separation of adjacent bright fringes is 2.0 mm. The separation of the slits is then doubled and the distance from the slits to the screen is increased to three times its original value."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the new separation of adjacent bright fringes?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0.33 mm"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes s to be inversely proportional to both D and d: 2.0 / (3 × 2) = 0.33 mm"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "1.3 mm"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Swaps the roles of D and d (s ∝ d / D): 2.0 × 2 / 3 = 1.3 mm"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "3.0 mm"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "12 mm"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes s to be directly proportional to both D and d: 2.0 × 3 × 2 = 12 mm"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "C",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "s = λD / d. D triples and d doubles: new s = 2.0 × 3 / 2 = 3.0 mm."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
  },
  {
   "source_ref": "pilot/c3-wave-phenomena#3",
   "number": 3,
   "document": {
    "schema_version": "1.0",
    "question_class": "mcq",
    "exam_section": "paper_1a",
    "levels": [
     "sl",
     "hl"
    ],
    "language": "en",
    "calculator": true,
    "difficulty": "medium",
    "primary_syllabus_node": "C.3",
    "secondary_syllabus_nodes": [],
    "outcome": "Sources in phase; path difference and the condition for destructive interference",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Two loudspeakers X and Y emit sound of the same frequency and are in phase. A microphone is placed at a point P that is 2.00 m from X and 2.68 m from Y. The speed of sound in air is 340 m s⁻¹."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the lowest frequency for which the intensity of the sound at P is a minimum?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "125 Hz"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes the path difference for destructive interference to be a quarter of a wavelength: λ = 2.72 m → 340 / 2.72 = 125 Hz"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "250 Hz"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "500 Hz"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Uses the condition for constructive interference (path difference = λ): 340 / 0.68 = 500 Hz"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "750 Hz"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes the next minimum (path difference = 3λ/2); there is also a minimum at this frequency but it is not the lowest: 3 × 340 / (2 × 0.68) = 750 Hz"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "Path difference = 2.68 − 2.00 = 0.68 m. For destructive interference the path difference = (n + ½)λ; the lowest frequency corresponds to the largest wavelength: λ/2 = 0.68 m → λ = 1.36 m → f = 340 / 1.36 = 250 Hz."
         }
        ]
       }
      ]
     },
     "assessment_objective": 3,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
