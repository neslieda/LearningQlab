          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "İki ucu açık boru bağıntısı üçüncü harmonik için kullanılır: 3 × 340 / (2 × 0.17) = 3000 Hz"
           }
          ]
         }
        ]
       }
