    "calculator": true,
    "difficulty": "medium",
    "primary_syllabus_node": "E.1",
    "secondary_syllabus_nodes": [],
    "outcome": "Discrete energy levels; photon energy E = hf = hc/λ",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "The diagram shows three energy levels of an atom."
        }
       ]
      },
      {
       "type": "figure",
       "attrs": {
        "stimulus_id": "fig1"
       }
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "The energies of the levels are −5.80 eV, −3.30 eV and −1.20 eV. Electron transitions take place between these levels."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the longest wavelength of the photons emitted in these transitions?"
        }
       ]
      }
     ]
    },
    "stimuli": [
     {
      "id": "fig1",
      "kind": "energy_level_diagram",
      "use": "read_only",
      "description": "An energy level diagram made of three horizontal lines. The lowest line is labelled −5.80 eV, the middle one −3.30 eV and the top one −1.20 eV. The diagram is not to scale. (The question can be solved without the figure, using these three values given in the text.)",
      "asset_id": null,
      "alt_text": null
     }
    ],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "270 nm"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Chooses the largest energy difference for the longest wavelength: 4.60 eV → 270 nm (misses that λ and E are inversely proportional)"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "497 nm"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Considers only the transition between the lowest two levels: 2.50 eV → 497 nm"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "592 nm"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "1040 nm"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Uses the magnitude of the energy of the top level instead of an energy difference: 1.20 eV → 1036 nm ≈ 1040 nm"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "C",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "The longest wavelength corresponds to the smallest energy difference. The differences are 2.50 eV, 2.10 eV, 4.60 eV. The smallest is 2.10 eV. λ = hc / E = (6.63 × 10⁻³⁴ × 3.00 × 10⁸) / (2.10 × 1.60 × 10⁻¹⁹) = 5.92 × 10⁻⁷ m = 592 nm."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "sl_core",
     "solution_step": null
    },
