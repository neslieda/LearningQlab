       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "In a fission reactor, each fission of a uranium-235 nucleus releases 2.5 neutrons on average. The reactor operates at a constant power output."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the average number of neutrons from each fission that go on to cause a further fission?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "ratio",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
