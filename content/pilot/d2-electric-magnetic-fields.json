    "outcome": "Field strength between parallel plates (E = V/d) and the force on a charge",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Two parallel metal plates are 15 mm apart in a vacuum. The potential difference between the plates is 3.0 kV. An alpha particle (charge +2"
        },
        {
         "marks": [],
         "type": "math_inline",
         "attrs": {
          "latex": "e"
         }
        },
        {
         "marks": [],
         "type": "text",
         "text": ") is at a point midway between the plates."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "math_inline",
         "attrs": {
          "latex": "e"
         }
        },
        {
         "marks": [],
         "type": "text",
         "text": " = 1.60 × 10⁻¹⁹ C"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the magnitude of the electric force on the alpha particle?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "1.4 × 10⁻¹⁷ N"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Uses E = V × d: 3.0 × 10³ × 0.015 = 45; F = 3.2 × 10⁻¹⁹ × 45 = 1.4 × 10⁻¹⁷ N"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "6.4 × 10⁻¹⁷ N"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Does not convert the distance to metres: E = 3.0 × 10³ / 15 = 200; F = 3.2 × 10⁻¹⁹ × 200 = 6.4 × 10⁻¹⁷ N"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "3.2 × 10⁻¹⁴ N"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes the charge of the alpha particle as e: 1.60 × 10⁻¹⁹ × 2.0 × 10⁵ = 3.2 × 10⁻¹⁴ N"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "6.4 × 10⁻¹⁴ N"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      }
     ],
     "correct_key": "D",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "E = V/d = 3.0 × 10³ / 0.015 = 2.0 × 10⁵ V m⁻¹ (the same everywhere between the plates). F = qE = 2 × 1.60 × 10⁻¹⁹ × 2.0 × 10⁵ = 6.4 × 10⁻¹⁴ N."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "sl_core",
