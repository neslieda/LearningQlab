    "outcome": "v = fλ; the speed of a sound wave depends on the medium",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A dolphin emits a sound wave of frequency 150 kHz. The speed of sound in seawater is 1500 m s⁻¹."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the wavelength of the sound wave in seawater?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0.010 m"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "10 m"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Does not convert the kHz prefix: 1500 / 150 = 10 m"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "100 m"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Inverts the ratio (f / v): 150 000 / 1500 = 100"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "2000 m"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Treats the sound wave like an electromagnetic wave and uses the speed of light: 3.00 × 10⁸ / (150 × 10³) = 2000 m"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "A",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "λ = v / f = 1500 / (150 × 10³) = 0.010 m."
         }
        ]
       }
      ]
     },
