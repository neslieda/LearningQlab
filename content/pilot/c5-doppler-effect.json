     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "While the source moves towards the observer, successive wavefronts get closer together in the region ahead; the wavelength at the observer decreases, the speed of sound is unchanged, and the frequency is greater than "
