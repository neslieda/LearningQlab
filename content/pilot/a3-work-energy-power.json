       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Uses mass instead of force (forgets "
           },
           {
            "marks": [],
            "type": "math_inline",
            "attrs": {
             "latex": "g"
            }
           },
           {
            "marks": [],
            "type": "text",
            "text": "): 150 × 0.40 / 840 = 0.071"
