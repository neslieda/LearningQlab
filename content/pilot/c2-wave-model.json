       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes 2.0 ms to be a quarter of the period (T = 8.0 ms → λ = 340 × 8.0 × 10⁻³ = 2.72 m) and takes the compression–rarefaction separation to be a full wavelength: 2.7 m"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "Two successive zero crossings are half a period apart: T = 4.0 ms. λ = vT = 340 × 4.0 × 10⁻³ = 1.36 m. The distance between the centre of a compression and the centre of the nearest rarefaction is half a wavelength: 0.68 m."
         }
        ]
       }
      ]
