    "secondary_syllabus_nodes": [],
    "outcome": "Fisyonda açığa çıkan enerjinin nükleon başına bağlanma enerjisinden hesabı",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A nucleus of nucleon number 240 has a binding energy per nucleon of 7.6 MeV. It undergoes fission into two nuclei, each of nucleon number 120 and binding energy per nucleon 8.5 MeV. No neutrons are released."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the energy released in this fission?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "2040 MeV"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Ürünlerin toplam bağlanma enerjisi, açığa çıkan enerji sanılır: 240 × 8.5 = 2040 MeV"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "216 MeV"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "108 MeV"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Yalnızca bir ürün çekirdek hesaba katılır: 120 × 0.90 = 108 MeV"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0.90 MeV"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Nükleon başına fark verilir; nükleon sayısıyla çarpılmaz: 8.5 − 7.6 = 0.90 MeV"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "Ürünlerin toplam bağlanma enerjisi = 2 × 120 × 8.5 = 2040 MeV. Başlangıç çekirdeğinin = 240 × 7.6 = 1824 MeV. Açığa çıkan enerji = 2040 − 1824 = 216 MeV (= 240 × 0.90)."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
