       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "The average over the surface is not taken (no division by 4): 600 × 0.70 = 420"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "The planet intercepts the radiation over a cross-section π"
         },
         {
          "marks": [],
          "type": "math_inline",
          "attrs": {
           "latex": "R"
          }
         },
         {
          "marks": [],
          "type": "text",
          "text": "², and the energy is spread over a surface 4π"
