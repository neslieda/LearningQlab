       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "529 Hz"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Moving-observer formula and the wrong direction (receding): 600 × (340 − 40) / 340 = 529 Hz"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "537 Hz"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Correct formula, wrong direction (receding source): 600 × 340 / (340 + 40) = 537 Hz"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "671 Hz"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Uses the moving-observer formula: 600 × (340 + 40) / 340 = 671 Hz. Applying the approximate relation valid for light (Δf/f ≈ v/c) to sound gives the same value: 600 + 600 × 40 / 340 = 671 Hz"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "680 Hz"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      }
     ],
     "correct_key": "D",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "Moving source, approaching: f′ = f v / (v − u"
         },
         {
          "marks": [
           {
            "type": "sub"
           }
          ],
          "type": "text",
          "text": "s"
         },
         {
          "marks": [],
          "type": "text",
          "text": ") = 600 × 340 / (340 − 40) = 680 Hz."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "ahl",
     "solution_step": null
