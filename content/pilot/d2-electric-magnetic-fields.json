           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Applies the grip rule the wrong way round (left hand, or reversed sense of circulation)"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "towards the bottom of the page"
