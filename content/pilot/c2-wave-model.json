    "outcome": "Longitudinal wave; period from displacement against time; compression–rarefaction separation",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A sound wave travels through air. The speed of sound in air is 340 m s⁻¹. A graph of displacement against time is drawn for one particle of the air. On the graph, the time between two adjacent instants at which the displacement is zero is 2.0 ms."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the distance between the centre of a compression and the centre of the nearest rarefaction?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0.34 m"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes 2.0 ms to be the full period: λ = 340 × 2.0 × 10⁻³ = 0.68 m; half of this is 0.34 m"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0.68 m"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "1.4 m"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes the compression–rarefaction separation to be a full wavelength: 1.36 ≈ 1.4 m"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "2.7 m"
            }
           ]
          }
         ]
