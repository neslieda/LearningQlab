 "questions": [
  {
   "source_ref": "pilot/e5-fusion-stars#1",
   "number": 1,
   "document": {
    "schema_version": "1.0",
    "question_class": "mcq",
    "exam_section": "paper_1a",
    "levels": [
     "sl",
     "hl"
    ],
    "language": "en",
    "calculator": true,
    "difficulty": "easy",
    "primary_syllabus_node": "E.5",
    "secondary_syllabus_nodes": [],
    "outcome": "Distance from parallax angle; parsec–light year conversion",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "The parallax angle of a star measured from Earth is 0.040 arc-seconds. 1 pc = 3.26 ly."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the distance from Earth to the star?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0.13 ly"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Takes the distance as directly proportional to the parallax angle: 0.040 × 3.26 = 0.13"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "7.7 ly"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Does the conversion the wrong way round: 25 / 3.26 = 7.7"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "25 ly"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Does not convert the value found in parsecs to light years: 25"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "82 ly"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      }
     ],
     "correct_key": "D",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "d (pc) = 1 / p (arc-seconds) = 1 / 0.040 = 25 pc. 25 × 3.26 = 81.5 ≈ 82 ly."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
