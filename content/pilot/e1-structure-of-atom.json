    "outcome": "Geiger–Marsden–Rutherford deneyinin nitel yorumu",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "In the Geiger–Marsden–Rutherford experiment, alpha particles are directed at a thin gold foil. A few alpha particles are deflected through angles greater than 90°."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Which feature of the atom is needed to explain these large deflections?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "statement",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "Most of the volume of the atom is empty space."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Deneyin öbür gözlemiyle (parçacıkların çoğunun sapmadan geçmesi) karıştırılır; boşluk büyük açılı sapmayı açıklamaz"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The positive charge is spread uniformly throughout the atom."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Düzgün dağılmış yük modeli (çekirdek öncesi model) alınır; bu model yalnızca çok küçük sapmalar verir"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The electrons occupy discrete energy levels."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Tayf kanıtı ile saçılma kanıtı karıştırılır; enerji düzeyleri saçılma deneyinin sonucu değildir"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The positive charge and most of the mass are concentrated in a very small region."
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      }
     ],
     "correct_key": "D",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "Bir alfa parçacığının geri saçılabilmesi için çok büyük bir itme kuvveti gerekir. Bu, ancak pozitif yükün küçük bir bölgede toplanmasıyla (yakın geçişte çok güçlü alan) ve bu bölgenin alfa parçacığından çok daha büyük kütleli olmasıyla açıklanır."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
