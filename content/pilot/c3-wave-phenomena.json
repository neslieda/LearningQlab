        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Gives the distance from the centre to the first minimum (half-width): λD / b = 12 mm"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
