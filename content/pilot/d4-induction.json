     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "3.0 V and 80 ms"
