    "outcome": "Bozunma sabiti; T½ = ln 2/λ; A = λN",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A freshly prepared sample contains 4.0 × 10¹² nuclei of a radioactive nuclide. The half-life of the nuclide is 20 minutes."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the initial activity of the sample?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "1.7 × 10⁹ Bq"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Bir yarı ömürdeki ortalama aktiflik alınır: (N/2) / T½ = 2.0 × 10¹² / 1200 = 1.7 × 10⁹"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "2.3 × 10⁹ Bq"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "3.3 × 10⁹ Bq"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "ln 2 çarpanı unutulur (λ = 1/T½): 4.0 × 10¹² / 1200 = 3.3 × 10⁹"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "1.4 × 10¹¹ Bq"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Yarı ömür saniyeye çevrilmez: (ln 2 / 20) × 4.0 × 10¹² = 1.4 × 10¹¹ (dakika başına bozunma, Bq değil)"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "T½ = 20 × 60 = 1200 s. λ = ln 2 / T½ = 5.78 × 10⁻⁴ s⁻¹. A = λN = 5.78 × 10⁻⁴ × 4.0 × 10¹² = 2.3 × 10⁹ Bq."
         }
        ]
       }
      ]
     },
