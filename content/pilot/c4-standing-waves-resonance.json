    "outcome": "Phase in a standing wave: points on either side of a node",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A standing wave of wavelength 0.80 m is formed on a string. Point X on the string is 0.10 m to the left of a node. Point Y on the string is 0.10 m to the right of the same node."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the phase difference between the oscillations of X and Y?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "word_phrase",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Assumes all points in a standing wave are in phase (true only within the same loop)"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "π/4 rad"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Uses the travelling-wave relation with the distance of one point from the node: 2π × 0.10 / 0.80 = π/4"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "π/2 rad"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Uses the travelling-wave relation with the distance X–Y: 2π × 0.20 / 0.80 = π/2"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "π rad"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      }
     ],
     "correct_key": "D",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "The separation of adjacent nodes is λ/2 = 0.40 m; X and Y are in neighbouring loops on either side of the same node. In a standing wave all the points within one loop are in phase; points in the neighbouring loop are in antiphase. The phase difference is π rad."
         }
        ]
       }
      ]
