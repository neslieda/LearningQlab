        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Bir ucu kapalı boruda da birinci harmoniğin tüm tam katlarının oluştuğu sanılır: 2 × 500 = 1000 Hz (bu desen kapalı uçta düğüm koşulunu sağlamaz)"
