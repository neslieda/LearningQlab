       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Thinks \"the fields of equal currents in opposite directions cancel\"; ignores that P is on opposite sides of the two wires"
