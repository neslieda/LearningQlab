  {
   "source_ref": "pilot/e5-fusion-stars#2",
   "number": 2,
   "document": {
    "schema_version": "1.0",
    "question_class": "mcq",
    "exam_section": "paper_1a",
    "levels": [
     "sl",
     "hl"
    ],
    "language": "en",
    "calculator": true,
    "difficulty": "medium",
    "primary_syllabus_node": "E.5",
    "secondary_syllabus_nodes": [],
    "outcome": "Determining stellar radius from luminosity and temperature (ratio)",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Star X has four times the luminosity of the Sun. The surface temperature of star X is half the surface temperature of the Sun. Both stars radiate as black bodies."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the ratio (radius of star X) / (radius of the Sun)?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "ratio",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0.5"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Does not invert the temperature ratio: R² = 4 × (½)⁴ = 0.25 → 0.5"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "4"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Uses the wrong power of temperature (R ∝ √L / T): 2 / 0.5 = 4"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "8"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "64"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Does not take the square root; gives the ratio of R²: 64"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "C",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "L = σ(4πR²)T⁴ → R² ∝ L / T⁴. Ratio of R² = 4 / (½)⁴ = 64. Ratio of radii = √64 = 8."
         }
        ]
       }
      ]
     },
     "assessment_objective": 3,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
  },
  {
   "source_ref": "pilot/e5-fusion-stars#3",
   "number": 3,
   "document": {
    "schema_version": "1.0",
    "question_class": "mcq",
    "exam_section": "paper_1a",
    "levels": [
     "sl",
     "hl"
    ],
    "language": "en",
    "calculator": true,
    "difficulty": "medium",
    "primary_syllabus_node": "E.5",
    "secondary_syllabus_nodes": [],
    "outcome": "Regions of the HR diagram",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "On a Hertzsprung–Russell (HR) diagram, luminosity is plotted on the vertical axis and surface temperature on the horizontal axis. A star has a surface temperature of 20 000 K and a luminosity of 0.01 "
        },
        {
         "marks": [],
         "type": "math_inline",
         "attrs": {
          "latex": "L"
         }
        },
        {
         "marks": [],
         "type": "text",
         "text": "☉, where "
        },
        {
         "marks": [],
         "type": "math_inline",
         "attrs": {
          "latex": "L"
         }
        },
        {
         "marks": [],
         "type": "text",
         "text": "☉ is the luminosity of the Sun."
        }
       ]
      },
      {
       "type": "figure",
       "attrs": {
        "stimulus_id": "fig1"
       }
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Which type of star is this?"
        }
       ]
      }
     ]
    },
    "stimuli": [
     {
      "id": "fig1",
      "kind": "graph",
      "use": "read_only",
      "description": "HR diagram. Vertical axis: luminosity / L☉, logarithmic scale, from 10⁻⁴ to 10⁶. Horizontal axis: surface temperature / K, decreasing from left to right (from 40 000 K to 2500 K). The main sequence is a band running from upper left to lower right; red giants and supergiants are at upper right; white dwarfs are at lower left. The regions are not labelled in the figure. (The question can be solved without the figure.)",
      "asset_id": null,
      "alt_text": null
     }
    ],
    "mcq": {
     "option_kind": "word_phrase",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "White dwarf"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "Main-sequence star"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Thinks the main sequence passes through every part of the diagram; a main-sequence star at this temperature is much brighter than the Sun"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "Red giant"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Associates low luminosity with a \"cool and large\" star; red giants are cool and brighter than the Sun"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "Supergiant"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Interprets high temperature alone as a \"very large star\"; supergiants have a very high luminosity"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "A",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "The star is much hotter than the Sun but much dimmer; it is in the lower left region of the diagram. A low luminosity at a high temperature requires a very small surface area: a white dwarf."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
