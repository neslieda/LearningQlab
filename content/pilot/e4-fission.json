         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "Its nuclei absorb neutrons readily."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Yavaşlatıcı ile kontrol çubuğu karıştırılır; nötron soğurmak kontrol çubuğunun işidir"
