  {
   "source_ref": "pilot/e5-fusion-stars#2",
   "number": 2,
   "document": {
    "schema_version": "1.0",
    "question_class": "mcq",
    "exam_section": "paper_1a",
    "levels": [
     "sl",
     "hl"
    ],
    "language": "en",
    "calculator": true,
    "difficulty": "medium",
    "primary_syllabus_node": "E.5",
    "secondary_syllabus_nodes": [],
    "outcome": "Yıldız yarıçapının ışınım gücü ve sıcaklıktan belirlenmesi (oran)",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Star X has four times the luminosity of the Sun. The surface temperature of star X is half the surface temperature of the Sun. Both stars radiate as black bodies."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the ratio (radius of star X) / (radius of the Sun)?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "ratio",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "0.5"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Sıcaklık oranı ters çevrilmez: R² = 4 × (½)⁴ = 0.25 → 0.5"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "4"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Sıcaklığın üssü yanlış alınır (R ∝ √L / T): 2 / 0.5 = 4"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "8"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "64"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Karekök alınmaz; R² oranı verilir: 64"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "C",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "L = σ(4πR²)T⁴ → R² ∝ L / T⁴. R² oranı = 4 / (½)⁴ = 64. Yarıçap oranı = √64 = 8."
         }
        ]
       }
      ]
     },
     "assessment_objective": 3,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
  },
