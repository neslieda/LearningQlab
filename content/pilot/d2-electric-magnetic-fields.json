    "calculator": true,
    "difficulty": "medium",
    "primary_syllabus_node": "D.2",
    "secondary_syllabus_nodes": [],
    "outcome": "Millikan experiment: equilibrium of a charged drop in a uniform field; quantization of charge",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A small oil drop carries 3 excess electrons. The drop is held stationary in a vacuum between two horizontal parallel plates when the potential difference between the plates is 600 V. The drop then gains 2 more electrons. The change in the mass of the drop is negligible."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the potential difference between the plates that holds the drop stationary now?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "200 V"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Reduces the potential difference by the fraction (added charge / initial charge): 600 × (1 − 2/3) = 200 V"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "360 V"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "600 V"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Thinks the required voltage is unchanged because the weight of the drop is unchanged"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "1000 V"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Inverts the ratio (V ∝ q): 600 × 5/3 = 1000 V"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "Equilibrium: qV/d = mg, so V ∝ 1/q (m, g, d constant). The charge increases from 3e to 5e: V = 600 × 3/5 = 360 V."
         }
        ]
       }
      ]
     },
