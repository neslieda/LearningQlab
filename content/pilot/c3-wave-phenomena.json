       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Monochromatic light of wavelength 600 nm is incident normally on a diffraction grating that has 400 lines per millimetre."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the highest order of maximum that can be observed?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "ratio",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "4"
