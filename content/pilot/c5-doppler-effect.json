         {
          "marks": [],
          "type": "math_inline",
          "attrs": {
           "latex": "f"
          }
         },
         {
          "marks": [],
          "type": "text",
          "text": ". The shift depends on the speed of the source, not its distance; because the speed is constant and directly towards the observer, the frequency heard is constant."
         }
        ]
       }
      ]
