    "outcome": "Magnetic field pattern and direction for a current-carrying straight wire",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Two long straight parallel wires X and Y are perpendicular to the page. Wire X is to the left of wire Y. The wires carry currents of equal magnitude. The current in X is directed "
        },
        {
         "marks": [
          {
           "type": "bold"
          }
         ],
         "type": "text",
         "text": "into"
        },
        {
         "marks": [],
         "type": "text",
         "text": " the page and the current in Y is directed "
        },
        {
         "marks": [
          {
           "type": "bold"
          }
         ],
         "type": "text",
         "text": "out of"
        },
        {
         "marks": [],
         "type": "text",
         "text": " the page. Point P is midway between the wires. The line XY is horizontal on the page."
        }
       ]
      },
      {
       "type": "figure",
       "attrs": {
        "stimulus_id": "fig1"
       }
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the direction of the resultant magnetic field at P?"
        }
       ]
      }
     ]
    },
    "stimuli": [
     {
      "id": "fig1",
      "kind": "schematic_diagram",
      "use": "read_only",
      "description": "On a horizontal line in the plane of the page, from left to right: wire X, point P, wire Y. X is perpendicular to the page and its current is into the page (⊗ symbol); Y is perpendicular to the page and its current is out of the page (⊙ symbol). P is exactly midway between X and Y. The \"top of the page\" and \"bottom of the page\" directions are perpendicular to the line XY. Diagram not to scale.",
      "asset_id": null,
      "alt_text": null
     }
    ],
    "mcq": {
     "option_kind": "statement",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "no direction (zero resultant field)"
