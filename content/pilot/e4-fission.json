           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Soğurulan ya da kaçan nötron sayısı (2.5 − 1) sorulanla karıştırılır"
           }
          ]
         }
        ]
       }
      },
      {
