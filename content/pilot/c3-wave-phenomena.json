           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Gives the number of maxima on both sides of the centre: 2 × 4 = 8"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "9"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Gives the total number of maxima seen on the screen: 2 × 4 + 1 = 9"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "A",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "d = 1.0 × 10⁻³ / 400 = 2.5 × 10⁻⁶ m. nλ = d sin θ and sin θ ≤ 1 → n ≤ d / λ = 2.5 × 10⁻⁶ / (600 × 10⁻⁹) = 4.17. The highest whole number is 4 (sin θ₄ = 0.96)."
         }
        ]
       }
      ]
     },
