       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A coil rotates at a constant rate in a uniform magnetic field. The emf induced in the coil varies sinusoidally with a maximum value of 6.0 V and a period of 40 ms. The frequency of rotation of the coil is then doubled. No other change is made."
        }
       ]
