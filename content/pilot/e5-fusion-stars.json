  {
   "source_ref": "pilot/e5-fusion-stars#4",
   "number": 4,
   "document": {
    "schema_version": "1.0",
    "question_class": "mcq",
    "exam_section": "paper_1a",
    "levels": [
     "sl",
     "hl"
    ],
    "language": "en",
    "calculator": true,
    "difficulty": "easy",
    "primary_syllabus_node": "E.5",
    "secondary_syllabus_nodes": [],
    "outcome": "Conditions for fusion: reason for high temperature",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Nuclear fusion of hydrogen takes place in the core of a main-sequence star, where the temperature is very high."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Why is a very high temperature needed for fusion?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "statement",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "To remove the electrons from the hydrogen atoms"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Confuses ionization with the condition for fusion; ionization takes place at much lower temperatures"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "To give nuclei enough kinetic energy to overcome their electric repulsion"
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "To increase the binding energy per nucleon of the hydrogen nuclei"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Thinks binding energy changes with temperature; it is a property of the nucleus independent of temperature"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "To produce enough radiation pressure to balance gravity"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Confuses the result of fusion (radiation pressure) with the condition for fusion"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "Nuclei are positively charged and repel each other. For them to approach close enough for the strong nuclear force to take effect, their kinetic energy, that is the temperature, must be very high."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
  },
  {
   "source_ref": "pilot/e5-fusion-stars#5",
   "number": 5,
   "document": {
    "schema_version": "1.0",
    "question_class": "mcq",
    "exam_section": "paper_1a",
    "levels": [
     "sl",
     "hl"
    ],
    "language": "en",
    "calculator": true,
    "difficulty": "medium",
    "primary_syllabus_node": "E.5",
    "secondary_syllabus_nodes": [],
    "outcome": "Stellar equilibrium: radiation pressure and gravity",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A main-sequence star is in equilibrium. The rate of fusion in the core of the star then decreases, so that the outward force due to radiation pressure in the core decreases."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What happens to the core as a result?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "statement",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "It contracts, because the gravitational force is now greater than the outward force due to pressure."
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "It expands, because the gravitational force is now less than the outward force due to pressure."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Sets up the force balance the wrong way round: thinks decreasing pressure leads to expansion"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "It stays the same size, because the gravitational force does not depend on the rate of fusion."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Concludes from the gravitational force not changing that the equilibrium does not change either; equilibrium is the equality of two effects"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "It expands, because a lower rate of fusion reduces the gravitational force on the core."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Thinks gravity is caused by fusion or changes with the rate of fusion; gravity depends on the mass of the star"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "A",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "At equilibrium the inward gravitational force and the outward force due to pressure are equal. When the rate of fusion decreases the outward force decreases, the gravitational force does not change; the resultant force is inward and the core contracts."
         }
        ]
       }
      ]
     },
     "assessment_objective": 3,
     "level_content": "sl_core",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
  },
  {
