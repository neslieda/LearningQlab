       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A small oil drop carries 3 excess electrons. The drop is held stationary in a vacuum between two horizontal parallel plates when the potential difference between the plates is 600 V. The drop then gains 2 more electrons. The change in the mass of the drop is negligible."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What is the potential difference between the plates that holds the drop stationary now?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "numeric_with_unit",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "200 V"
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
