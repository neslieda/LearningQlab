  {
   "source_ref": "pilot/e5-fusion-stars#5",
   "number": 5,
   "document": {
    "schema_version": "1.0",
    "question_class": "mcq",
    "exam_section": "paper_1a",
    "levels": [
     "sl",
     "hl"
    ],
    "language": "en",
    "calculator": true,
    "difficulty": "medium",
    "primary_syllabus_node": "E.5",
    "secondary_syllabus_nodes": [],
    "outcome": "Yıldız dengesi: ışınım basıncı ve kütle çekimi",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A main-sequence star is in equilibrium. The rate of fusion in the core of the star then decreases, so that the outward force due to radiation pressure in the core decreases."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "What happens to the core as a result?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "statement",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "It contracts, because the gravitational force is now greater than the outward force due to pressure."
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "It expands, because the gravitational force is now less than the outward force due to pressure."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Kuvvet dengesi ters kurulur: azalan basıncın genleşmeye yol açtığı düşünülür"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "It stays the same size, because the gravitational force does not depend on the rate of fusion."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Kütle çekiminin değişmemesinden dengenin de değişmediği sonucu çıkarılır; denge iki etkinin eşitliğidir"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "It expands, because a lower rate of fusion reduces the gravitational force on the core."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
