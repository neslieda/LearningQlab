    "outcome": "Relationship between flux linkage and emf in a rotating coil",
    "stem": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "A rectangular coil rotates at a constant rate in a uniform magnetic field. The axis of rotation lies in the plane of the coil and is at right angles to the field. At one instant the plane of the coil is "
        },
        {
         "marks": [
          {
           "type": "bold"
          }
         ],
         "type": "text",
         "text": "parallel"
        },
        {
         "marks": [],
         "type": "text",
         "text": " to the magnetic field lines."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "marks": [],
         "type": "text",
         "text": "Which describes the magnitudes of the magnetic flux linkage and of the induced emf at this instant?"
        }
       ]
      }
     ]
    },
    "stimuli": [],
    "mcq": {
     "option_kind": "statement",
     "option_layout": "single_value",
     "column_headers": [],
     "statements": [],
     "options": [
      {
       "key": "A",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The flux linkage is zero and the emf is zero."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Thinks the emf is proportional to the flux linkage itself (not to its rate of change)"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "B",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The flux linkage is zero and the emf is a maximum."
            }
           ]
          }
         ]
        }
       ],
       "rationale": null
      },
      {
       "key": "C",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The flux linkage is a maximum and the emf is zero."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Confuses the coil plane being parallel to the field with it being perpendicular"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "D",
       "cells": [
        {
         "type": "doc",
         "content": [
          {
           "type": "paragraph",
           "content": [
            {
             "marks": [],
             "type": "text",
             "text": "The flux linkage is a maximum and the emf is a maximum."
            }
           ]
          }
         ]
        }
       ],
       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "Confuses the position and also thinks the emf is proportional to the flux"
           }
          ]
         }
        ]
       }
      }
     ],
     "correct_key": "B",
     "explanation": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "marks": [],
          "type": "text",
          "text": "When the plane of the coil is parallel to the field lines, no field lines pass through the coil: the flux linkage is zero. At the same instant the sides of the coil cut the field lines at right angles; the flux linkage changes most rapidly at this instant. By Faraday's law the emf is proportional to the rate of change of flux linkage, so it is at its maximum value."
         }
        ]
       }
      ]
     },
     "assessment_objective": 2,
     "level_content": "ahl",
     "solution_step": null
    },
    "parts": [],
    "total_marks": 1,
    "solution_model": null
   }
