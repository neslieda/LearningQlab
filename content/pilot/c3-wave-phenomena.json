       "rationale": {
        "type": "doc",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "marks": [],
            "type": "text",
            "text": "D ve d'nin rolleri değiştirilir (s ∝ d / D): 2.0 × 2 / 3 = 1.3 mm"
           }
          ]
         }
        ]
       }
      },
      {
